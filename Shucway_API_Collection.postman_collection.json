									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/usuarios/1",
							"host": ["{{baseUrl}}"],
							"path": ["usuarios", "1"]
						},
						"description": "Eliminar usuario (soft delete - cambia estado a desactivado).\n\n**Permisos:** Requiere Administrador (nivel 80)\n\n**NOTA:** No elimina físicamente, solo desactiva."
					},
					"response": []
				},
				{
					"name": "Obtener Roles de Usuario",
