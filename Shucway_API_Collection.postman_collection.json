						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/usuarios/roles/1",
							"host": ["{{baseUrl}}"],
							"path": ["usuarios", "roles", "1"]
						},
						"description": "Remover un rol de un usuario.\n\n**Permisos:** Requiere Administrador (nivel 80)\n\n**NOTA:** El parámetro es el ID de la tabla usuario_rol, no el ID del rol."
					},
					"response": []
				}
			],
			"description": "Endpoints para gestión de usuarios (perfiles)"
		},
