								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idRol\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/usuarios/1/roles",
							"host": ["{{baseUrl}}"],
							"path": ["usuarios", "1", "roles"]
						},
						"description": "Asignar un rol a un usuario.\n\n**Permisos:** Requiere Administrador (nivel 80)\n\n**IDs de Roles:**\n- 1: Propietario (nivel 100)\n- 2: Administrador (nivel 80)\n- 3: Cajero (nivel 30)\n- 4: Cliente (nivel 10)"
					},
					"response": []
				},
				{
					"name": "Remover Rol de Usuario",
