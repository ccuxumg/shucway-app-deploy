							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/usuarios/1/roles",
							"host": ["{{baseUrl}}"],
							"path": ["usuarios", "1", "roles"]
						},
						"description": "Obtener todos los roles asignados a un usuario.\n\n**Permisos:** Requiere Cajero (nivel 30)"
					},
					"response": []
				},
				{
					"name": "Asignar Rol a Usuario",
					"request": {
						"auth": {
							"type": "bearer",
